# Copy to .env and fill in. NEVER commit .env — this repo is PUBLIC.
# Production reads the same keys from the Modal secret `angies-checklists`.

# Kintone. Either "angieslobster" or the full host; both are accepted.
KINTONE_SUBDOMAIN=

# One READ-ONLY token per app. This tool never writes to Kintone.
# Opening checklist — two versions; a store needs either one.
KINTONE_OPENING_A_APP_ID=841
KINTONE_OPENING_A_API_TOKEN=
KINTONE_OPENING_B_APP_ID=842
KINTONE_OPENING_B_API_TOKEN=
# Quality & Food Safety — AM and PM.
KINTONE_QFS_APP_ID=807
KINTONE_QFS_API_TOKEN=
# Rush Readiness — AM and PM.
KINTONE_RUSH_APP_ID=814
KINTONE_RUSH_API_TOKEN=
# Closing checklist.
KINTONE_CLOSING_APP_ID=810
KINTONE_CLOSING_API_TOKEN=
# Weekly Cleaning — graded on the Monday email only.
KINTONE_CLEANING_APP_ID=846
KINTONE_CLEANING_API_TOKEN=
# Ops / Store Directory — stores, districts, DMs. Active stores only.
KINTONE_STOREDIR_APP_ID=897
KINTONE_STOREDIR_API_TOKEN=

# --- email (Microsoft Graph, app-only client credentials) ---------------------
# Same tenant/app registration the punch report and pick sheets use.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_ADDRESS=

# Who gets the report. Comma-separated. Changing this is a secret edit, not code.
CHECKLIST_RECIPIENTS=
# Copied on the live send only. Comma-separated.
CHECKLIST_CC=

# Who is told when a run fails. Never the DMs.
ALERT_RECIPIENTS=
# Fallback single recipient for dry runs.
TEST_RECIPIENT=

# "1" sends only to ALERT_RECIPIENTS/TEST_RECIPIENT with [DRY RUN] in the
# subject. This is how the job launches. Flip to "0" to go live.
CHECKLIST_DRY_RUN=1
